# Copy this file to .env and fill in your values
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/ddcrm

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=http://localhost:5173
TIMEZONE=Asia/Kolkata

# First admin account, created automatically if the users table is empty
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@dialdesk.in
ADMIN_PASSWORD=admin123

# Links in emails and messages point here
APP_BASE_URL=http://localhost:5173

# Email: leave SMTP_HOST empty while testing; messages are then only listed under Settings > Notification log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DialDesk <no-reply@dialdesk.in>

# SMS / WhatsApp provider APIs (leave empty while testing)
SMS_API_URL=
SMS_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
